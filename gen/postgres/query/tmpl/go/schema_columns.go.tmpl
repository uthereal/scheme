{{- range .Composites }}
  {{- $compName := .Name }}

  // {{ $compName }}Column represents a strongly typed PostgreSQL composite
  // column.
  type Composite{{ $compName }}Column struct {
    postgres.BaseColumn
    postgres.ComparableColumn[{{ $compName }}]
  }

  func (c Composite{{ $compName }}Column) String() string {
    return c.BaseColumn.String()
  }

  {{- range .Fields }}
    // {{ .Name }} returns a strongly typed column representing the
    // {{ .ColumnName }} field.
    func (c Composite{{ $compName }}Column) {{ .Name }}() {{ .String }} {
      col := "(" + c.BaseColumn.String() + ").{{ .ColumnName }}"
      return {{ .String }}{
        BaseColumn: postgres.BaseColumn(col),
        {{- if .Category.SupportOperatorEquality }}
          ComparableColumn: postgres.ComparableColumn[{{ .GoBaseType }}](col),
        {{- end }}
        {{- if .Category.SupportOperatorMembership }}
          ArrayableColumn: postgres.ArrayableColumn[{{ .GoBaseType }}](col),
        {{- end }}
        {{- if .Category.SupportOperatorRelational }}
          OrderableColumn: postgres.OrderableColumn[{{ .GoBaseType }}](col),
        {{- end }}
      }
    }
  {{- end }}

  // Field returns a postgres.DynamicColumn representing a nested field within
  // the
  // composite type. It allows for querying against specific struct properties
  // using PostgreSQL's (column).field syntax.
  func (c Composite{{ $compName }}Column) Field(
		name string,
	) postgres.DynamicColumn {
    fieldSql := "(" + c.BaseColumn.String() + ")." + name
    return postgres.DynamicColumn{
      BaseColumn:       postgres.BaseColumn(fieldSql),
      ComparableColumn: postgres.ComparableColumn[any](fieldSql),
      ArrayableColumn:  postgres.ArrayableColumn[any](fieldSql),
      OrderableColumn:  postgres.OrderableColumn[any](fieldSql),
    }
  }
{{- end }}
