{{- /* gotype: github.com/uthereal/scheme/gen/postgres/ast.ModelGo */ -}}

{{- $modelName := .Name }}

// {{ $modelName }}Create provides strongly-typed setter functions for
// inserting a {{ $modelName }} record.
var {{ $modelName }}Create = struct {
  {{- range .Fields }}
    {{ .Name }} func({{ .GoType }}) postgres.MutateOption
    {{- if not (eq .GoType "bool") }}
    {{ .Name }}Null func() postgres.MutateOption
    {{- end }}
  {{- end }}
}{
  {{- range .Fields }}
    {{ .Name }}: func(v {{ .GoType }}) postgres.MutateOption {
      return func(m map[postgres.Column]any) {
        m[{{ $modelName }}Columns.{{ .Name }}] = v
      }
    },
    {{- if not (eq .GoType "bool") }}
    {{ .Name }}Null: func() postgres.MutateOption {
      return func(m map[postgres.Column]any) {
        m[{{ $modelName }}Columns.{{ .Name }}] = nil
      }
    },
    {{- end }}
  {{- end }}
}

// Create inserts a single {{ $modelName }} record into the database.
func (q *{{ $modelName }}Query) Create(
  ctx context.Context, opts ...postgres.MutateOption,
) (*{{ $modelName }}, error) {
  if len(q.state.Returning) == 0 {
    q = q.Returning(
      {{- range .Fields }}
        {{ $modelName }}Columns.{{ .Name }},
      {{- end }}
    )
  }
  res, err := q.CreateMany(ctx, opts)
  if err != nil {
    return nil, err
  }
  if len(res) == 0 {
    return nil, nil
  }
  return res[0], nil
}

// CreateMany inserts multiple {{ $modelName }} records into the database in a
// single batch operation.
func (q *{{ $modelName }}Query) CreateMany(
  ctx context.Context, items ...[]postgres.MutateOption,
) ([]*{{ $modelName }}, error) {
  if len(items) == 0 {
    return nil, nil
  }

  // Evaluate the functional options into maps of column -> value
  rowsData := make([]map[postgres.Column]any, 0, len(items))
  var activeCols []postgres.Column
  colSet := make(map[postgres.Column]struct{})

  for _, rowOpts := range items {
    m := make(map[postgres.Column]any)
    for _, opt := range rowOpts {
      opt(m)
    }
    rowsData = append(rowsData, m)

    // Track all unique columns touched across the entire batch
    for col := range m {
      _, exists := colSet[col]
      if !exists {
        colSet[col] = struct{}{}
        activeCols = append(activeCols, col)
      }
    }
  }

  if len(activeCols) == 0 {
    return nil, errors.New("no columns to insert")
  }

  var query strings.Builder
  var numBuf [20]byte
  query.Grow(512)
  query.WriteString(`INSERT INTO {{ .TableFullName }} (`)

  for i, col := range activeCols {
    if i > 0 {
      query.WriteString(", ")
    }
    query.WriteString(col.String())
  }
  query.WriteString(") SELECT * FROM unnest(")

  var args = make([]any, len(activeCols))

  for j, col := range activeCols {
    if j > 0 {
      query.WriteString(", ")
    }
    query.WriteString("$")
    query.Write(strconv.AppendInt(numBuf[:0], int64(j+1), 10))
    query.WriteString("::")

    switch col.String() {
    {{- range .Fields }}
    case {{ $modelName }}Columns.{{ .Name }}.String():
      query.WriteString("{{ .PgBaseType }}[]")
      arr := make([]*{{ .GoBaseType }}, len(rowsData))
      for i, m := range rowsData {
        val, ok := m[col]
        if ok && val != nil {
          {{- if .IsPtr }}
          arr[i] = val.(*{{ .GoBaseType }})
          {{- else }}
          v := val.({{ .GoBaseType }})
          arr[i] = &v
          {{- end }}
        }
      }
      args[j] = arr
    {{- end }}
    default:
      return nil, fmt.Errorf("unknown column -> %s", col.String())
    }
  }
  query.WriteString(")")
  returning := q.state.Returning
  if len(returning) == 0 {
    _, err := q.db.Exec(ctx, query.String(), args...)
    if err != nil {
      return nil, err
    }
    return nil, nil
  }

  colStr, colMappers, err := q.buildColumnMappers(returning)
  if err != nil {
    return nil, err
  }

  query.WriteString(" RETURNING ")
  query.WriteString(colStr)

  dbRows, err := q.db.Query(ctx, query.String(), args...)
  if err != nil {
    return nil, err
  }
  defer dbRows.Close()
  var results = make([]*{{ $modelName }}, 0, len(items))
  ptrs := make([]any, len(colMappers))
  for i := 0; dbRows.Next(); i++ {
    if i >= len(items) {
      return nil, errors.New("database returned more rows than expected")
    }

    var clone {{ $modelName }}
    for j, mapper := range colMappers {
      mapper(&clone, ptrs, j)
    }

    err = dbRows.Scan(ptrs...)
    if err != nil {
      return nil, err
    }
    results = append(results, &clone)
  }

  err = dbRows.Err()
  if err != nil {
    return nil, err
  }

  return results, nil
}
